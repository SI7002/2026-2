{
  "Comment": "BookStore ingestion from PostgreSQL to the Raw zone in S3",
  "QueryLanguage": "JSONata",
  "StartAt": "Glue-StartJobRun-Raw-Books",
  "States": {
    "Glue-StartJobRun-Raw-Books": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_bookstore",
        "Arguments": {
          "--target_entity": "books",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "Next": "Glue-StartJobRun-Raw-Customers"
    },
    "Glue-StartJobRun-Raw-Customers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_bookstore",
        "Arguments": {
          "--target_entity": "customers",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "Next": "Glue-StartJobRun-Raw-Orders"
    },
    "Glue-StartJobRun-Raw-Orders": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_bookstore",
        "Arguments": {
          "--target_entity": "orders",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "Next": "Glue-StartJobRun-Raw-OrderItems"
    },
    "Glue-StartJobRun-Raw-OrderItems": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_etl_bookstore",
        "Arguments": {
          "--target_entity": "order_items",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Glue.ConcurrentRunsExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    }
  }
}